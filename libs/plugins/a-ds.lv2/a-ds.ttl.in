@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix lv2: <http://lv2plug.in/ns/lv2core#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix unit: <http://lv2plug.in/ns/extensions/units#> .

<https://phaedra.arcanumgames.es/plugins/ds>
    a lv2:Plugin, lv2:DynamicsPlugin ;
    doap:name "Phaedra DS" ;
    rdfs:comment "Stereo de-esser with voice and allround detection, wide and split processing." ;
    lv2:minorVersion 0 ; lv2:microVersion 1 ;
    lv2:optionalFeature lv2:hardRTCapable ;
    lv2:port
    [ a lv2:AudioPort, lv2:InputPort ; lv2:index 0 ; lv2:symbol "in_l" ; lv2:name "Input L" ],
    [ a lv2:AudioPort, lv2:InputPort ; lv2:index 1 ; lv2:symbol "in_r" ; lv2:name "Input R" ],
    [ a lv2:AudioPort, lv2:OutputPort ; lv2:index 2 ; lv2:symbol "out_l" ; lv2:name "Output L" ],
    [ a lv2:AudioPort, lv2:OutputPort ; lv2:index 3 ; lv2:symbol "out_r" ; lv2:name "Output R" ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 4 ; lv2:symbol "threshold" ; lv2:name "Threshold" ; lv2:default -28 ; lv2:minimum -60 ; lv2:maximum 0 ; unit:unit unit:db ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 5 ; lv2:symbol "range" ; lv2:name "Range" ; lv2:default 10 ; lv2:minimum 0 ; lv2:maximum 24 ; unit:unit unit:db ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 6 ; lv2:symbol "frequency" ; lv2:name "Frequency" ; lv2:default 6500 ; lv2:minimum 2000 ; lv2:maximum 16000 ; unit:unit unit:hz ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 7 ; lv2:symbol "attack" ; lv2:name "Attack" ; lv2:default 1 ; lv2:minimum 0.1 ; lv2:maximum 20 ; unit:unit unit:ms ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 8 ; lv2:symbol "release" ; lv2:name "Release" ; lv2:default 70 ; lv2:minimum 5 ; lv2:maximum 400 ; unit:unit unit:ms ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 9 ; lv2:symbol "lookahead" ; lv2:name "Lookahead" ; lv2:default 2 ; lv2:minimum 0 ; lv2:maximum 20 ; unit:unit unit:ms ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 10 ; lv2:symbol "link" ; lv2:name "Stereo Link" ; lv2:default 100 ; lv2:minimum 0 ; lv2:maximum 100 ; unit:unit unit:pc ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 11 ; lv2:symbol "mix" ; lv2:name "Mix" ; lv2:default 100 ; lv2:minimum 0 ; lv2:maximum 100 ; unit:unit unit:pc ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 12 ; lv2:symbol "mode" ; lv2:name "Detection" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:integer, lv2:enumeration ;
      lv2:scalePoint [ rdfs:label "Voice" ; rdf:value 0 ], [ rdfs:label "Allround" ; rdf:value 1 ] ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 13 ; lv2:symbol "processing" ; lv2:name "Processing" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:integer, lv2:enumeration ;
      lv2:scalePoint [ rdfs:label "Wide" ; rdf:value 0 ], [ rdfs:label "Split" ; rdf:value 1 ] ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 14 ; lv2:symbol "audition" ; lv2:name "Listen" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 2 ; lv2:portProperty lv2:integer, lv2:enumeration ;
      lv2:scalePoint [ rdfs:label "Off" ; rdf:value 0 ], [ rdfs:label "Sidechain" ; rdf:value 1 ], [ rdfs:label "Removed" ; rdf:value 2 ] ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 15 ; lv2:symbol "bypass" ; lv2:name "Bypass" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:integer, lv2:toggled ],
    [ a lv2:ControlPort, lv2:OutputPort ; lv2:index 16 ; lv2:symbol "reduction" ; lv2:name "Gain Reduction" ; lv2:minimum 0 ; lv2:maximum 24 ; unit:unit unit:db ],
    [ a lv2:ControlPort, lv2:OutputPort ; lv2:index 17 ; lv2:symbol "latency" ; lv2:name "Latency" ; lv2:minimum 0 ; lv2:maximum 7680 ;
      lv2:portProperty lv2:reportsLatency, lv2:integer ; unit:unit unit:frame ] .