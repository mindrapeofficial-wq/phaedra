@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix lv2: <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix unit: <http://lv2plug.in/ns/extensions/units#> .

<https://phaedra.arcanumgames.es/plugins/air>
    a lv2:Plugin, lv2:FilterPlugin ;
    doap:name "Phaedra Air" ;
    rdfs:comment "Two-band dynamic high-frequency enhancer." ;
    lv2:microVersion 0 ;
    lv2:minorVersion 1 ;
    lv2:optionalFeature lv2:hardRTCapable ;
    lv2:port
    [ a lv2:AudioPort, lv2:InputPort ; lv2:index 0 ; lv2:symbol "in_l" ; lv2:name "Input L" ],
    [ a lv2:AudioPort, lv2:InputPort ; lv2:index 1 ; lv2:symbol "in_r" ; lv2:name "Input R" ],
    [ a lv2:AudioPort, lv2:OutputPort ; lv2:index 2 ; lv2:symbol "out_l" ; lv2:name "Output L" ],
    [ a lv2:AudioPort, lv2:OutputPort ; lv2:index 3 ; lv2:symbol "out_r" ; lv2:name "Output R" ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 4 ; lv2:symbol "mid" ; lv2:name "Mid Air" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 100 ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 5 ; lv2:symbol "high" ; lv2:name "High Air" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 100 ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 6 ; lv2:symbol "link" ; lv2:name "Link (High follows Mid)" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:integer, lv2:toggled ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 7 ; lv2:symbol "trim" ; lv2:name "Trim" ; lv2:default 0 ; lv2:minimum -18 ; lv2:maximum 6 ; unit:unit unit:db ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 8 ; lv2:symbol "bypass" ; lv2:name "Bypass" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:integer, lv2:toggled ] .
