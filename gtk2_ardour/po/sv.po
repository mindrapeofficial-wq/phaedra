#: add_route_dialog.cc:178 duplicate_routes_dialog.cc:61
#: rc_option_editor.cc:3975 trigger_ui.cc:765
msgid "Last"
msgstr "Sista"

#: add_route_dialog.cc:181 recorder_ui.cc:1251
msgid "Flexible-I/O"
msgstr "Flexibel I/O"

#: add_route_dialog.cc:182 recorder_ui.cc:1252
msgid "Strict-I/O"
msgstr "Strikt I/O"

#: add_route_dialog.cc:216
msgid "Template/Type"
msgstr "Mall/Typ"

#: add_route_dialog.cc:218 session_dialog.cc:554 session_dialog.cc:937
msgid "Modified With"
msgstr "Modifierad med"

#: add_route_dialog.cc:306 rc_option_editor.cc:4857 recorder_ui.cc:1283
msgid ""
"With strict-i/o enabled, Effect Processors will not modify the number of "
"channels on a track. The number of output channels will always match the "
"number of input channels."
msgstr ""
"När strict-i/o är aktiverat kommer effektprocessorerna inte att ändra "
"antalet kanaler på ett spår. Antalet utgångskanaler kommer alltid att matcha "
"antalet ingångskanaler."

#: add_route_dialog.cc:329
msgid "Add selected items (and leave dialog open)"
msgstr "Lägg till valda objekt (och lämna dialogrutan öppen)"

#: add_route_dialog.cc:356
msgid "Add and Close"
msgstr "Lägg till och stäng"

