msgid "Stop recording when an xrun occurs"
msgstr "Detener grabación al detectar xrun"

#: rc_option_editor.cc:4023
msgid ""
"<b>When enabled</b> %1 will stop recording if an over- or underrun is "
"detected by the audio engine"
msgstr ""
"Si está <b>habilitado</b> %1 dejará de grabar si el motor de audio detecta "
"un x-run"

#: rc_option_editor.cc:4029
msgid "Create markers where xruns occur"
msgstr "Crear marca en posición de xrun"

#: rc_option_editor.cc:4037
msgid "Reset xrun counter when starting to record"
msgstr "Reiniciar el contador de xruns al empezar a grabar"

#: rc_option_editor.cc:4043 rc_option_editor.cc:4045 rc_option_editor.cc:4053
#: rc_option_editor.cc:4071 rc_option_editor.cc:4073 rc_option_editor.cc:4075
