  <url type="homepage">https://github.com/mindrapeofficial-wq/phaedra</url>
  <keywords>
    <keyword>Phaedra</keyword>
    <keyword>DAW</keyword>
    <keyword>Digital Audio Workstation</keyword>
    <keyword>Mixing</keyword>
    <keyword>Mastering</keyword>
  </keywords>
