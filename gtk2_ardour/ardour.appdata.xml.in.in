  <name>Phaedra</name>
  <releases>
    <release version="@VERSION@" date="@DATE@" />
  </releases>
  <summary>Digital Audio Workstation</summary>
  <description>
    <p>
      Phaedra is a multi-channel digital audio workstation, allowing you to
      record, edit, mix and master audio and MIDI projects.
    </p>
    <p>
      It is targeted at audio engineers, musicians, soundtrack editors and
      composers.
    </p>
  </description>
  <url type="bugtracker">https://github.com/mindrapeofficial-wq/phaedra/issues</url>
